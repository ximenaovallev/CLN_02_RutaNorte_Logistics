<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_RutaNorte" targetNamespace="http://rutanorte.example/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:message id="Msg_Cambio" name="Solicitud de cambio o cancelación"/>
  <bpmn:message id="Msg_Consulta" name="Consulta de estado del servicio"/>
  <bpmn:dataStore id="DS1" name="Registro centralizado del servicio"/>
  <bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="RutaNorte Logistics – Servicio de transporte" processRef="Proc_1"/></bpmn:collaboration>
  <bpmn:process id="Proc_1" name="Servicio de transporte RutaNorte Logistics" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="Lane_0" name="Cliente">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Ventas">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Operaciones">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
