    <bpmn:startEvent id="S1" name="S1 · Cliente requiere transporte"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="T1" name="T1 · Solicitar cotización [Solicitado]"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:dataOutputAssociation id="da1"><bpmn:targetRef>DO1r</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="G1 · ¿Respuesta del cliente?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="E1 · Cotización rechazada"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="T2" name="T2 · Elaborar y presentar cotización [Cotizado]"><bpmn:incoming>f2</bpmn:incoming><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:dataOutputAssociation id="da2"><bpmn:targetRef>DO2r</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="T3" name="T3 · Modificar cotización (mientras está en proceso)"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T4" name="T4 · Generar orden de servicio [Confirmado]"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:dataOutputAssociation id="da3"><bpmn:targetRef>DO3r</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="T6" name="T6 · Revisar carga, capacidad de unidad y disponibilidad de operador"><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="G2 · ¿Unidad adecuada y operador disponible?"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T7" name="T7 · Buscar reemplazo, actualizar asignación y registrar cambio en historial"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T8" name="T8 · Asignar unidad y operador [Unidad asignada]"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T13" name="T13 · Evaluar y definir solución (apoyo o cambio de unidad)"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E6" name="E6 · Avería / retraso atendido"><bpmn:incoming>f23</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="T15" name="T15 · Evaluar incidencia y definir siguiente paso"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E3" name="E3 · Incidencia en origen gestionada"><bpmn:incoming>f18</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="T21" name="T21 · Evaluar incidencia, definir acción e informar al cliente"><bpmn:incoming>f30</bpmn:incoming><bpmn:outgoing>f31</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E5" name="E5 · Incidencia en destino gestionada"><bpmn:incoming>f31</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="S4" name="S4 · Se requiere medir la operación"><bpmn:outgoing>f34</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="T23" name="T23 · Consultar historial: tiempos, retrasos, incidencias y cumplimiento"><bpmn:incoming>f34</bpmn:incoming><bpmn:outgoing>f35</bpmn:outgoing><bpmn:dataInputAssociation id="da9"><bpmn:sourceRef>DS1b</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:task>
    <bpmn:endEvent id="E7" name="E7 · Indicadores consultados"><bpmn:incoming>f35</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="T9" name="T9 · Recibir y validar la mercancía en origen"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="G3 · ¿Coincide con lo declarado?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T10" name="T10 · Registrar recepción y evidencia [Recolectado]"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:dataOutputAssociation id="da4"><bpmn:targetRef>DO4r</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="T11" name="T11 · Trasladar la mercancía [En tránsito]"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:task>
    <bpmn:boundaryEvent id="B1" name="B1 · Avería o retraso" cancelActivity="false" attachedToRef="T11"><bpmn:outgoing>f21</bpmn:outgoing><bpmn:escalationEventDefinition id="B1_ed"/></bpmn:boundaryEvent>
    <bpmn:task id="T12" name="T12 · Registrar y reportar avería o retraso a Operaciones"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T14" name="T14 · Registrar y reportar incidencia en origen (con evidencia)"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:dataOutputAssociation id="da5"><bpmn:targetRef>DO5r</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="T16" name="T16 · Llegar a destino [Llegada a destino]"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T17" name="T17 · Entregar la mercancía"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="G4 · ¿Entrega posible, completa y sin daño?"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing><bpmn:outgoing>f29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T20" name="T20 · Registrar y reportar incidencia en destino (con evidencia)"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing><bpmn:dataOutputAssociation id="da6"><bpmn:targetRef>DO6r</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="T19" name="T19 · Registrar entrega: receptor y evidencia [Entregado]"><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing><bpmn:dataOutputAssociation id="da7"><bpmn:targetRef>DO7r</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:endEvent id="E4" name="E4 · Servicio entregado"><bpmn:incoming>f28</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="T18" name="T18 · Recibir la mercancía"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:task>
    <bpmn:startEvent id="S3" name="S3 · Cliente pregunta por el estado de su servicio"><bpmn:outgoing>f32</bpmn:outgoing><bpmn:messageEventDefinition id="S3_md" messageRef="Msg_Consulta"/></bpmn:startEvent>
    <bpmn:task id="T22" name="T22 · Consultar estado, eventos, retrasos e incidencias"><bpmn:incoming>f32</bpmn:incoming><bpmn:outgoing>f33</bpmn:outgoing><bpmn:dataInputAssociation id="da8"><bpmn:sourceRef>DS1a</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:task>
    <bpmn:endEvent id="E8" name="E8 · Cliente informado"><bpmn:incoming>f33</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="SUB" name="Cambio o cancelación posterior a la orden de servicio" triggeredByEvent="true">
      <bpmn:startEvent id="S2" name="S2 · Solicitud de cambio o cancelación (posterior a la orden)" isInterrupting="false"><bpmn:outgoing>sf1</bpmn:outgoing><bpmn:messageEventDefinition id="S2_md" messageRef="Msg_Cambio"/></bpmn:startEvent>
      <bpmn:task id="T5" name="T5 · Registrar solicitud: qué cambia, quién la solicita y motivo"><bpmn:incoming>sf1</bpmn:incoming><bpmn:outgoing>sf2</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="G5" name="G5 · ¿Es cancelación?"><bpmn:incoming>sf2</bpmn:incoming><bpmn:outgoing>sf3</bpmn:outgoing><bpmn:outgoing>sf4</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:task id="T5A" name="T5A · Registrar cancelación (quién la solicita y motivo)"><bpmn:incoming>sf3</bpmn:incoming><bpmn:outgoing>sf5</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="E2" name="E2 · Servicio cancelado"><bpmn:incoming>sf5</bpmn:incoming><bpmn:terminateEventDefinition id="E2_td"/></bpmn:endEvent>
