        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Destinatario">
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Atención al Cliente">
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E8</bpmn:flowNodeRef>
