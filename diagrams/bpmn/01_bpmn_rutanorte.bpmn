        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Operador">
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
